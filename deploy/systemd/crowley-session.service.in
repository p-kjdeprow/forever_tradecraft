[Unit]
Description=Crowley repeating scan session controller
After=graphical-session.target
Conflicts=crowley-scan.service

[Service]
Type=simple
# %t is XDG_RUNTIME_DIR. The installed command resolves its user config.
ExecStart=%h/.local/bin/crowley-session --config %E/crowley/session.toml daemon
EnvironmentFile=%E/crowley/secrets.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=%t
PassEnvironment=XAUTHORITY
# The IPC socket lives in %t/crowley, which is tmpfs and gone after a reboot.
# Both units create it (private, kept across unit restarts).
RuntimeDirectory=crowley
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
