#!/bin/sh
set -eu
umask 077

# Rendered by crowley-ops from the selected packaged target.  The placeholders
# are target facts; CROWLEY_WINE remains a host-provided Wine binary path.
#
# Battle.net is the only component that can issue the game's login ticket, so
# the game is started through Battle.net's own Play action:
#   1. ensure one logged-in Battle.net runs in the prefix (Client.SingleInstance
#      must be "true" so later invocations reach it over IPC instead of starting
#      a second instance that deletes the saved login token);
#   2. select the product with one --exec per invocation (Battle.net rejects a
#      repeated --exec);
#   3. un-maximize the Battle.net window, activate it and click Play with
#      `crowley-ops battle-net-play`.  After a fresh start the embedded Chromium
#      view has no keyboard focus, so Return does nothing and Tab reaches the
#      logo menu (which contains Log Out); the click is therefore the only safe
#      activation.  It is a full simulated human click (curved, Fitts-timed
#      pointer path through the pinned XTEST emitter, held under the canonical
#      click-rate gate), never a bare click command.  If the game has not started
#      after GAME_START_ATTEMPT_SECONDS the click is retried, at most
#      PLAY_ATTEMPTS clicks in all;
#   4. make the game window real fullscreen and press Return once (keyboard, to
#      the game window) at character select to enter the world.
GAME_ROOT={{GAME_ROOT}}
PRODUCT_DIR={{PRODUCT_DIR}}
EXECUTABLE={{EXECUTABLE}}
WINDOW_CLASS={{WINDOW_CLASS}}
PRODUCT={{PRODUCT}}
PREFIX={{WINE_PREFIX}}
WINE="${CROWLEY_WINE:?set CROWLEY_WINE to the reviewed Wine executable}"

DISPLAY_VALUE={{DISPLAY}}
XAUTHORITY_VALUE="${XAUTHORITY:?set XAUTHORITY to the reviewed Xwayland authorization file}"
[ -r "$XAUTHORITY_VALUE" ] || { printf '%s\n' 'No readable Xauthority for the active desktop.' >&2; exit 1; }

BATTLE_NET="$PREFIX/drive_c/Program Files (x86)/Battle.net/Battle.net.exe"
BATTLE_NET_USER_DIR="$PREFIX/drive_c/users/$(id -un)"
BATTLE_NET_CONFIG="$BATTLE_NET_USER_DIR/AppData/Roaming/Battle.net/Battle.net.config"
BATTLE_NET_LOGS="$BATTLE_NET_USER_DIR/AppData/Local/Battle.net/Logs"
LOGIN_TIMEOUT_SECONDS=180
GAME_TIMEOUT_SECONDS=120
GAME_START_ATTEMPT_SECONDS=20
PLAY_ATTEMPTS=3

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

OWNER_UID=$(id -u)
EXPECTED_ARGV0={{EXPECTED_ARGV0}}
owned_game_running() {
    for proc in /proc/[0-9]*; do
        [ -r "$proc/comm" ] || continue
        [ "$(sed -n '1p' "$proc/comm")" = "$EXECUTABLE" ] || continue
        [ -r "$proc/status" ] || continue
        [ "$(sed -n 's/^Uid:[[:space:]]*\([0-9]*\).*/\1/p' "$proc/status" | sed -n '1p')" = "$OWNER_UID" ] || continue
        [ -r "$proc/cmdline" ] || continue
        argv0=$(tr '\000' '\n' < "$proc/cmdline" | sed -n '1p')
        [ "$argv0" = "$EXPECTED_ARGV0" ] || continue
        [ -r "$proc/environ" ] || continue
        tr '\000' '\n' < "$proc/environ" 2>/dev/null | grep -Fqx "WINEPREFIX=$PREFIX" || continue
        return 0
    done
    return 1
}

# The main Battle.net process has no arguments.  Wine reports its argv0 as the
# Unix path when it was started from a shell (this launcher) and as the Windows
# path when a Windows process (autostart, Battle.net's updater) started it.
# Helper processes carry --type=..., and transient --exec invocations carry
# --exec=..., so both are excluded by the empty second argument.
battle_net_running() {
    for proc in /proc/[0-9]*; do
        [ -r "$proc/cmdline" ] || continue
        argv0=$(tr '\000' '\n' < "$proc/cmdline" | sed -n '1p')
        [ "$argv0" = "$BATTLE_NET" ] || [ "$argv0" = 'C:\Program Files (x86)\Battle.net\Battle.net.exe' ] || continue
        [ "$(tr '\000' '\n' < "$proc/cmdline" | sed -n '2p')" = '' ] || continue
        [ "$(sed -n 's/^Uid:[[:space:]]*\([0-9]*\).*/\1/p' "$proc/status" | sed -n '1p')" = "$OWNER_UID" ] || continue
        tr '\000' '\n' < "$proc/environ" 2>/dev/null | grep -Fqx "WINEPREFIX=$PREFIX" || continue
        return 0
    done
    return 1
}

if owned_game_running; then
    printf '%s\n' 'Owned WoW client already running; launch refused.' >&2
    exit 0
fi

[ -f "$GAME_ROOT/$PRODUCT_DIR/$EXECUTABLE" ] || fail "Game executable is missing: $GAME_ROOT/$PRODUCT_DIR/$EXECUTABLE"
[ -r "$BATTLE_NET_CONFIG" ] || fail "Battle.net configuration is unreadable: $BATTLE_NET_CONFIG"
grep -Eq '"SingleInstance"[[:space:]]*:[[:space:]]*"true"' "$BATTLE_NET_CONFIG" \
    || fail 'Battle.net Client.SingleInstance must be "true"; stop Battle.net and set it before launching.'
# crowley-ops is installed next to this launcher and resolved from PATH (the
# supervisor unit sets PATH to the user's bin directory).
CROWLEY_OPS=$(command -v crowley-ops) || fail 'crowley-ops is not on PATH; install Crowley first.'

LOGDIR="${XDG_STATE_HOME:?XDG_STATE_HOME is not set; run the launcher from the authenticated graphical session, which provides it}/crowley/executor-evidence"
mkdir -p -m 0700 "$LOGDIR"
chmod 700 "$LOGDIR"

game_env() {
    env DISPLAY="$DISPLAY_VALUE" XAUTHORITY="$XAUTHORITY_VALUE" \
        WINEPREFIX="$PREFIX" WINEARCH=win64 WINEESYNC=1 STAGING_SHARED_MEMORY=1 \
        DXVK_CONFIG_FILE="$PREFIX/dxvk.conf" DXVK_HUD=compiler \
        DXVK_STATE_CACHE_PATH="$PREFIX" __GL_DXVK_OPTIMIZATIONS=1 \
        __GL_SHADER_DISK_CACHE=1 __GL_SHADER_DISK_CACHE_PATH="$PREFIX" WINEDEBUG=-all \
        "$@"
}

x11() {
    DISPLAY="$DISPLAY_VALUE" XAUTHORITY="$XAUTHORITY_VALUE" "$@"
}

battle_net_exec() {
    game_env "$WINE" "$BATTLE_NET" --exec="$1" >>"$LOGDIR/launcher.log" 2>&1 </dev/null
}

# Battle.net names each log battle.net-<UTC timestamp>.log, so names sort in
# creation order.  Its short-lived helper processes write their own small logs,
# so the login evidence is searched in every log created after the launch, not
# only the most recently modified one.
latest_battle_net_log_name() {
    ls "$BATTLE_NET_LOGS" 2>/dev/null | grep -E '^battle\.net-[0-9T.]+\.log$' | LC_ALL=C sort | sed -n '$p'
}

logs_created_after() {
    ls "$BATTLE_NET_LOGS" 2>/dev/null | grep -E '^battle\.net-[0-9T.]+\.log$' | LC_ALL=C sort \
        | awk -v after="$1" '$0 > after { print }'
}

if ! battle_net_running; then
    before=$(latest_battle_net_log_name)
    game_env setsid "$WINE" "$BATTLE_NET" >>"$LOGDIR/launcher.log" 2>&1 </dev/null &
    waited=0
    logged_in=''
    while :; do
        for name in $(logs_created_after "$before"); do
            log="$BATTLE_NET_LOGS/$name"
            if grep -Fq 'UAuth: browser state changed: LoginCredential' "$log"; then
                fail 'Battle.net requires an interactive login; its saved login token is gone.'
            fi
            if grep -Fq "GameAccount added to family: family=WoW account=GameAccount(WoW:$PRODUCT " "$log"; then
                logged_in=1
            fi
        done
        [ -z "$logged_in" ] || break
        [ "$waited" -lt "$LOGIN_TIMEOUT_SECONDS" ] || fail 'Battle.net did not finish logging in.'
        sleep 1
        waited=$((waited + 1))
    done
fi

battle_net_exec "launch_uid $PRODUCT"
battle_net_exec 'focus play'

# The real main window is the visible battle.net.exe-class window named
# "Battle.net"; a name-only search also matches mutter's frame windows.
# xdotool applies its class and name flags to one shared pattern (OR), so search by
# class only and filter on the exact window name.  No match exits 1.
candidates=$(x11 xdotool search --onlyvisible --class '^battle\.net\.exe$' 2>/dev/null) || candidates=''
window=''
window_count=0
for candidate in $candidates; do
    [ "$(x11 xdotool getwindowname "$candidate" 2>/dev/null)" = 'Battle.net' ] || continue
    window=$candidate
    window_count=$((window_count + 1))
done
[ "$window_count" -eq 1 ] || fail "Expected exactly one visible Battle.net window, found $window_count."
x11 wmctrl -i -r "$window" -b remove,maximized_vert,maximized_horz
sleep 1
x11 xdotool windowactivate --sync "$window"

# Each attempt captures the screen afresh, locates the blue Play button and
# clicks it; the click gate guarantees at least 1 s between automated clicks.
attempt=1
while :; do
    # Never click again once the game process exists.
    ! owned_game_running || break
    x11 "$CROWLEY_OPS" battle-net-play --window "$window" >>"$LOGDIR/launcher.log" 2>&1 \
        || fail 'Clicking the Battle.net Play button failed; see launcher.log.'
    waited=0
    while [ "$waited" -lt "$GAME_START_ATTEMPT_SECONDS" ] && ! owned_game_running; do
        sleep 1
        waited=$((waited + 1))
    done
    ! owned_game_running || break
    [ "$attempt" -lt "$PLAY_ATTEMPTS" ] || fail 'Battle.net did not start the game after clicking Play.'
    attempt=$((attempt + 1))
    x11 xdotool windowactivate --sync "$window"
done

# The client's windowed-fullscreen mode is mapped by Wine as a window maximized
# into the desktop work area (below the top bar, beside the dock).  Crowley's
# calibration pins the client at the display origin at full display size, so
# ask the window manager for real fullscreen and verify the result.  Wine maps
# the window with fixed-size WM_NORMAL_HINTS and _MOTIF_WM_HINTS limited to
# move|close, so the window manager would ignore a fullscreen request; clear
# both hints first.
game_window=''
waited=0
while [ -z "$game_window" ]; do
    [ "$waited" -lt "$GAME_TIMEOUT_SECONDS" ] || fail 'The game window did not appear.'
    game_window=$(x11 xdotool search --onlyvisible --class "^$WINDOW_CLASS\$" 2>/dev/null | sed -n '1p') || game_window=''
    [ -n "$game_window" ] || { sleep 1; waited=$((waited + 1)); }
done
request_fullscreen() {
    x11 xprop -id "$game_window" -remove WM_NORMAL_HINTS
    x11 xprop -id "$game_window" -f _MOTIF_WM_HINTS 32c -set _MOTIF_WM_HINTS '0x2, 0x0, 0x0, 0x0, 0x0'
    x11 wmctrl -i -r "$game_window" -b add,fullscreen
}
display_size=$(x11 xdotool getdisplaygeometry)
display_wxh=$(printf '%s' "$display_size" | tr ' ' x)
waited=0
while :; do
    eval "$(x11 xdotool getwindowgeometry --shell "$game_window")"
    state=$(x11 xprop -id "$game_window" _NET_WM_STATE)
    children=$(x11 xwininfo -id "$game_window" -children)
    child_count=$(printf '%s\n' "$children" | sed -n 's/^[[:space:]]*\([0-9][0-9]*\) child.*/\1/p')
    child_size=$(printf '%s\n' "$children" | sed -n 's/^[[:space:]]*0x[0-9a-f]*.*[[:space:]]\([0-9][0-9]*x[0-9][0-9]*\)+[-0-9]*+[-0-9]*[[:space:]].*/\1/p' | sed -n '1p')
    if [ "$X $Y $WIDTH $HEIGHT" = "0 0 $display_size" ] \
        && printf '%s\n' "$state" | grep -Fq _NET_WM_STATE_FULLSCREEN \
        && [ "$child_count" = 1 ] \
        && [ "$child_size" = "$display_wxh" ]; then
        break
    fi
    # Wine can re-apply its hints while the client is still starting, so the
    # request is repeated until the verified state is reached.
    request_fullscreen
    [ "$waited" -lt 30 ] || fail "The game window is not fullscreen at the display origin: $X $Y $WIDTH $HEIGHT, state '$state', $child_count child(ren) of size '$child_size'."
    sleep 1
    waited=$((waited + 1))
done

# Enter World.  The -launcherlogin flow logs in with the last character
# selected, so the client sits at character select.  The shell has no cheap
# detector for that screen, so wait a fixed settle period, then send one Return
# (Return at character select is Enter World).  No click is involved.
CHARACTER_SELECT_SETTLE_SECONDS=45
sleep "$CHARACTER_SELECT_SETTLE_SECONDS"
x11 xdotool windowactivate --sync "$game_window"
x11 xdotool key --clearmodifiers Return
printf '%s\n' 'WoW client started by Battle.net.'
