[Unit]
Description=Crowley repeating scan session controller
After=graphical-session.target

[Service]
Type=simple
# %t is XDG_RUNTIME_DIR. The installed command resolves its user config.
ExecStart=%h/.local/bin/crowley-session --config %E/crowley/session.toml daemon
EnvironmentFile=%E/crowley/secrets.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=%t
PassEnvironment=XAUTHORITY
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
