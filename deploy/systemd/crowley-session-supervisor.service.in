[Unit]
Description=Crowley session transient-blocker supervisor
After=crowley-session.service

[Service]
Type=simple
# Resumes allowlisted transient BLOCKED states; never PAUSED or STOPPED. After a long
# BLOCKED or daemon outage it relaunches the game with crowley-world-of-warcraft, which
# needs CROWLEY_WINE (secrets.env), XAUTHORITY, XDG_STATE_HOME and the display below.
# %t is XDG_RUNTIME_DIR and %S is the user state directory (~/.local/state).
ExecStart=%h/.local/bin/crowley-session --config %E/crowley/session.toml supervise
EnvironmentFile=%E/crowley/secrets.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_STATE_HOME=%S
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
PassEnvironment=XAUTHORITY
# A relaunch may start Battle.net, which then parents the game client.  Stopping or
# restarting the supervisor must not take that process tree down with it.
KillMode=process
# The IPC socket lives in %t/crowley, which is tmpfs and gone after a reboot.
# Both units create it (private, kept across unit restarts).
RuntimeDirectory=crowley
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
