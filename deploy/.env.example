# Copy to $XDG_CONFIG_HOME/crowley/secrets.env and chmod 600.
# Generate a token with your local secrets tool.
CROWLEY_API_TOKEN=change-me
CROWLEY_DB_PASSWORD=change-me
# Set this to the tag printed by `crowley-ops image build`.
CROWLEY_IMAGE_VERSION=0.1.0
# 127.0.0.1 = this machine only. Use your Tailscale IP (tailscale ip -4) once the game runs elsewhere.
CROWLEY_BIND=127.0.0.1
# Paper trading (crowley-paper-trading.service) reads the database URL from here, never from deploy/config/.
CROWLEY_DATABASE_URL=postgresql://crowley:change-me@127.0.0.1:5432/crowley
CROWLEY_PAPER_RUN=launch-paper-run
