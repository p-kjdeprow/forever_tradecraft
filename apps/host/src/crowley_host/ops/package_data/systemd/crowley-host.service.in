[Unit]
Description=Crowley scanner-aware host loop
After=graphical-session.target
# A crash loop keeps retrying every RestartSec instead of hitting the start limit.
StartLimitIntervalSec=0

[Service]
Type=simple
# Observes the owned game client and keeps the auction house scanned. Startup recovery uses
# CROWLEY_WINE (secrets.env), the current graphical session, XDG_STATE_HOME and this display.
# %t is XDG_RUNTIME_DIR, %S the user state directory.
ExecStart=%h/.local/bin/crowley-host run
EnvironmentFile=%E/crowley/secrets.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_STATE_HOME=%S
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
PassEnvironment=XAUTHORITY
# Battle.net and the game client outlive the host. Stopping or restarting this unit must
# preserve those application processes.
KillMode=process
# The GUI lease and status file live in %t/crowley, which is tmpfs (private, kept across
# unit restarts).
RuntimeDirectory=crowley
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
